# GPL-2.0-or-later. Component diagnostic of the unchanged pinned Tcl model.
# Motion is imposed by this probe; it is not generated by AGC/RCS commands.
set src [lindex $argv 0]
set init [open "$src/Contributed/LM_Simulator/lm_simulator.tcl" r]
set initialization [join [lrange [split [read $init] "\n"] 123 240] "\n"]
close $init
source [lindex $argv 1]
source "$src/Contributed/LM_Simulator/modules/AGC_Simulation_Monitor_Control.tcl"
proc write_socket {op address} {
    global packets
    lappend packets "$op,$address"
}
puts "TCL\t[info patchlevel]"
while {[gets stdin line] >= 0} {
    # id mode imposed_yaw_rate dt steps imposed_X_delta initial_X zero locked
    lassign $line id mode rate dt steps dx initial_x zero locked
    if {$mode ni {rate delta}} {error "Unsupported diagnostic mode"}
    if {$dt <= 0 || $steps < 1 || $steps > 10000} {error "Invalid diagnostic duration"}
    eval $initialization
    set gimbalLock $locked
    set bo(12,5) $zero
    set IMUX_ANGLE $initial_x
    set PIMUX $initial_x
    set Omega_Yaw $rate
    for {set step 1} {$step <= $steps} {incr step} {
        set packets {}
        if {$mode eq "rate"} {
            set Delta_Time2 $dt
            dynamic_simulation
        } else {
            modify_gimbal_angle $dx 0 0
        }
        puts [join [list $id $step [expr {$step*$dt}] $Omega_Yaw \
            $IMUX_ANGLE $PIMUX $IMUY_ANGLE $IMUZ_ANGLE $Omega_Pitch \
            $Omega_Roll $ANGLE_INCR [join $packets {;}]] "\t"]
    }
}
puts "COMPONENT_PROBE_COMPLETE"
