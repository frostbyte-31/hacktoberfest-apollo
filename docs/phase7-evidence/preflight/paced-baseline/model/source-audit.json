      "lines": [
        {
          "line": 496,
          "text": ""
        },
        {
          "line": 497,
          "text": "# *************************************************************************************************"
        },
        {
          "line": 498,
          "text": "# **** Function: Modify a specific IMU Delta Gimbal-Angle par1=X; par2=Y; par3=Z               ****"
        },
        {
          "line": 499,
          "text": "# *************************************************************************************************"
        },
        {
          "line": 500,
          "text": "proc modify_gimbal_angle {dx dy dz} {"
        },
        {
          "line": 501,
          "text": " global IMUX_ANGLE IMUY_ANGLE IMUZ_ANGLE ANGLE_INCR"
        },
        {
          "line": 502,
          "text": " global PIMUX PIMUY PIMUZ bo gimbalLock"
        },
        {
          "line": 503,
          "text": " global Omega_Roll Omega_Pitch Omega_Yaw DEG_TO_RAD RAD_TO_DEG PI 2PI"
        },
        {
          "line": 504,
          "text": ""
        },
        {
          "line": 505,
          "text": " if {$gimbalLock == 1 || $bo(12,5) == 1} {return}"
        },
        {
          "line": 506,
          "text": " set ang_delta 0"
        },
        {
          "line": 507,
          "text": ""
        },
        {
          "line": 508,
          "text": " # ---- Modify X-Axis ----"
        },
        {
          "line": 509,
          "text": " if {$dx != 0} {"
        },
        {
          "line": 510,
          "text": "   # ---- Calculate New X-Angle ----"
        },
        {
          "line": 511,
          "text": "   set IMUX_ANGLE [expr $IMUX_ANGLE + $dx]"
        },
        {
          "line": 512,
          "text": "   if {$IMUX_ANGLE < 0}   {set IMUX_ANGLE [expr $IMUX_ANGLE + 360]}"
        },
        {
          "line": 513,
          "text": "   if {$IMUX_ANGLE >= 360} {set IMUX_ANGLE [expr $IMUX_ANGLE - 360]}"
        },
        {
          "line": 514,
          "text": ""
        },
        {
          "line": 515,
          "text": "   # ---- Calculate Delta between X-Angle and already feeded IMU X-Angle ----"
        },
        {
          "line": 516,
          "text": "   set dx [expr  $IMUX_ANGLE - $PIMUX]"
        },
        {
          "line": 517,
          "text": "   if {$dx < -180}   {set dx [expr $dx + 360]}"
        },
        {
          "line": 518,
          "text": "   if {$dx > 180} {set dx [expr $dx - 360]}"
        },
        {
          "line": 519,
          "text": ""
        },
        {
          "line": 520,
          "text": "   # ---- Feed yaAGC with the new Angular Delta ----"
        },
        {
          "line": 521,
          "text": "   if {$dx >= 0} {set ANGLE_INCR_SIGN $ANGLE_INCR} else {set ANGLE_INCR_SIGN -$ANGLE_INCR}"
        },
        {
          "line": 522,
          "text": "   set ang_delta [expr abs($dx)]"
        },
        {
          "line": 523,
          "text": "   while {$ang_delta > $ANGLE_INCR} {"
        },
        {
          "line": 524,
          "text": "     set PIMUX [expr $PIMUX + $ANGLE_INCR_SIGN]"
        },
        {
          "line": 525,
          "text": "     set ang_delta [expr $ang_delta - $ANGLE_INCR]"
        },
        {
          "line": 526,
          "text": "     # ---- LM X-Axis/YAW-Axis ----"
        },
        {
          "line": 527,
          "text": "     if {$Omega_Yaw < 4} {"
        },
        {
          "line": 528,
          "text": "       if {$ANGLE_INCR_SIGN < 0} {write_socket \"MCDU\" 32} else {write_socket \"PCDU\" 32}"
        },
        {
          "line": 529,
          "text": "     } else {"
        },
        {
          "line": 530,
          "text": "       if {$ANGLE_INCR_SIGN < 0} {write_socket \"MCDU_FAST\" 32} else {write_socket \"PCDU_FAST\" 32}"
        },
        {
          "line": 531,
          "text": "     }"
        },
        {
          "line": 532,
          "text": "   }"
        },
        {
          "line": 533,
          "text": ""
        },
        {
          "line": 534,
          "text": "   # ---- Check for Angular Boundaries ----"
        },
        {
          "line": 535,
          "text": "   if {$PIMUX < 0}    {set PIMUX [expr $PIMUX + 360]}"
        },
        {
          "line": 536,
          "text": "   if {$PIMUX >= 360} {set PIMUX [expr $PIMUX - 360]}"
        },
        {
          "line": 537,
          "text": " }"
        },
        {
          "line": 538,
          "text": ""
        },
        {
          "line": 539,
          "text": " # ---- Modify Y-Axis ----"
        },
        {
          "line": 540,
          "text": " if {$dy != 0} {"
        },
        {
          "line": 541,
          "text": "   # ---- Calculate new IMU Y-Angel ----"
        }
      ]
    },
    {
      "source": "Contributed/LM_Simulator/modules/AGC_IMU.tcl",
      "sha256": "4f63cf0954d4587ec6e983428d7e43d4473c11da72210444c2aa0ae4204e9c7e",
      "start_line": 652,
      "end_line": 692,
      "lines": [
        {
          "line": 652,
          "text": "   if {$counts > 0} {incr PIPAZ_COUNT 1; write_socket \"PINC\" 41}"
        },
        {
          "line": 653,
          "text": " }"
        },
        {
          "line": 654,
          "text": "}"
        },
        {
          "line": 655,
          "text": ""
        },
        {
          "line": 656,
          "text": ""
        },
        {
          "line": 657,
          "text": "# *************************************************************************************************"
        },
        {
          "line": 658,
          "text": "# **** Function: Transform angular deltas in Body Axes into Stable Member angular deltas       ****"
        },
        {
          "line": 659,
          "text": "# *************************************************************************************************"
        },
        {
          "line": 660,
          "text": "proc Transform_BodyAxes_StableMember {dp dq dr} {"
        },
        {
          "line": 661,
          "text": " global IMUX_ANGLE IMUY_ANGLE IMUZ_ANGLE RAD_TO_DEG DEG_TO_RAD PI 2PI"
        },
        {
          "line": 662,
          "text": ""
        },
        {
          "line": 663,
          "text": " set dp [expr $dp * $DEG_TO_RAD]"
        },
        {
          "line": 664,
          "text": " set dq [expr $dq * $DEG_TO_RAD]"
        },
        {
          "line": 665,
          "text": " set dr [expr $dr * $DEG_TO_RAD]"
        },
        {
          "line": 666,
          "text": ""
        },
        {
          "line": 667,
          "text": " set IMUX_ANGLE_b [expr $IMUX_ANGLE * $DEG_TO_RAD]"
        },
        {
          "line": 668,
          "text": " set IMUY_ANGLE_b [expr $IMUY_ANGLE * $DEG_TO_RAD]"
        },
        {
          "line": 669,
          "text": " set IMUZ_ANGLE_b [expr $IMUZ_ANGLE * $DEG_TO_RAD]"
        },
        {
          "line": 670,
          "text": ""
        },
        {
          "line": 671,
          "text": " set MPI [expr sin($IMUZ_ANGLE_b)]"
        },
        {
          "line": 672,
          "text": " set MQI [expr cos($IMUZ_ANGLE_b) * cos($IMUX_ANGLE_b)]"
        },
        {
          "line": 673,
          "text": " set MQM [expr sin($IMUX_ANGLE_b)]"
        },
        {
          "line": 674,
          "text": " set MRI [expr -cos($IMUZ_ANGLE_b) * sin($IMUX_ANGLE_b)]"
        },
        {
          "line": 675,
          "text": " set MRM [expr cos($IMUX_ANGLE_b)]"
        },
        {
          "line": 676,
          "text": " set nenner [expr $MRM * $MQI - $MRI * $MQM]"
        },
        {
          "line": 677,
          "text": ""
        },
        {
          "line": 678,
          "text": " # ---- Calculate Angular Change ----"
        },
        {
          "line": 679,
          "text": " set do_b [expr $dp - ($dq * $MRM * $MPI - $dr * $MQM * $MPI) / $nenner]"
        },
        {
          "line": 680,
          "text": " set di_b [expr ($dq * $MRM - $dr * $MQM) / $nenner]"
        },
        {
          "line": 681,
          "text": " set dm_b [expr ($dr * $MQI - $dq * $MRI) / $nenner]"
        },
        {
          "line": 682,
          "text": ""
        },
        {
          "line": 683,
          "text": " # ---- Check for Angular Boundaries ----"
        },
        {
          "line": 684,
          "text": " if {$do_b < -$2PI}   {set do_b [expr $do_b + $2PI]}"
        },
        {
          "line": 685,
          "text": " if {$do_b >= $2PI} {set do_b [expr $do_b - $2PI]}"
        },
        {
          "line": 686,
          "text": " if {$di_b < -$2PI}   {set di_b [expr $di_b + $2PI]}"
        },
        {
          "line": 687,
          "text": " if {$di_b >= $2PI} {set di_b [expr $di_b - $2PI]}"
        },
        {
          "line": 688,
          "text": " if {$dm_b < -$2PI}   {set dm_b [expr $dm_b + $2PI]}"
        },
        {
          "line": 689,
          "text": " if {$dm_b >= $2PI} {set dm_b [expr $dm_b - $2PI]}"
        },
        {
          "line": 690,
          "text": ""
        },
        {
          "line": 691,
          "text": " # ---- Rad to Deg and call of Gimbal Angle Modification ----"
        },
        {
          "line": 692,
          "text": " modify_gimbal_angle [expr $do_b * $RAD_TO_DEG] [expr $di_b * $RAD_TO_DEG] [expr $dm_b * $RAD_TO_DEG]"
        }
      ]
    },
    {
      "source": "Contributed/LM_Simulator/modules/AGC_Simulation_Monitor_Control.tcl",
      "sha256": "594463405c85a11a10b2ca158f637b87d55fd8d7d3660bb38c91ca80a3cdab60",
      "start_line": 208,
      "end_line": 215,
      "lines": [
        {
          "line": 208,
          "text": " set m [expr $LM_Weight_KG / 65535.0]"
        },
        {
          "line": 209,
          "text": " set Alpha_Yaw [expr $RAD_TO_DEG_PI4 * ($b($LM_CONFIG,YAW) + $a($LM_CONFIG,YAW)/($m + $c($LM_CONFIG,YAW)))]"
        },
        {
          "line": 210,
          "text": " set Alpha_Pitch [expr $RAD_TO_DEG_PI4 * ($b($LM_CONFIG,PITCH) + $a($LM_CONFIG,PITCH)/($m + $c($LM_CONFIG,PITCH)))]"
        },
        {
          "line": 211,
          "text": " set Alpha_Roll [expr $RAD_TO_DEG_PI4 * ($b($LM_CONFIG,ROLL) + $a($LM_CONFIG,ROLL)/($m + $c($LM_CONFIG,ROLL)))]"
        },
        {
          "line": 212,
          "text": ""
        },
        {
          "line": 213,
          "text": " # ---- Feed Angular Changes (Delta Time * Omega) into the IMU ----"
        },
        {
          "line": 214,
          "text": " Transform_BodyAxes_StableMember [expr $Omega_Yaw * $Delta_Time2] [expr $Omega_Pitch * $Delta_Time2] [expr $Omega_Roll * $Delta_Time2]"
        },
        {
          "line": 215,
          "text": "}"
        }
      ]
    },
    {
      "source": "Contributed/LM_Simulator/modules/AGC_Simulation_Monitor_Control.tcl",
      "sha256": "594463405c85a11a10b2ca158f637b87d55fd8d7d3660bb38c91ca80a3cdab60",
