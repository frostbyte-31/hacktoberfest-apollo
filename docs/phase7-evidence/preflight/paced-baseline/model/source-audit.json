      "lines": [
        {
          "line": 290,
          "text": ""
        },
        {
          "line": 291,
          "text": " # ---- Calculate Delta Omega, Omega and LM weight change ----"
        },
        {
          "line": 292,
          "text": " if {$RCS_Propellant_Mass_KG > 0} {"
        },
        {
          "line": 293,
          "text": "   set Delta_Omega_Yaw [expr $Alpha_Yaw * $Delta_Time * $np]"
        },
        {
          "line": 294,
          "text": "   set Delta_Omega_Pitch [expr $Alpha_Pitch * $Delta_Time * ($nu - $nv)]"
        },
        {
          "line": 295,
          "text": "   set Delta_Omega_Roll [expr $Alpha_Roll * $Delta_Time * ($nu + $nv)]"
        },
        {
          "line": 296,
          "text": ""
        },
        {
          "line": 297,
          "text": "   set Omega_Yaw [expr $Omega_Yaw + $Delta_Omega_Yaw]"
        },
        {
          "line": 298,
          "text": "   set Omega_Pitch [expr $Omega_Pitch + $Delta_Omega_Pitch]"
        },
        {
          "line": 299,
          "text": "   set Omega_Roll [expr $Omega_Roll + $Delta_Omega_Roll]"
        },
        {
          "line": 300,
          "text": ""
        },
        {
          "line": 301,
          "text": "   set RCS_Fuel_Flow [expr (abs($nv1) + abs($nv2) + abs($nu1) + abs($nu2) + abs($np1) + abs($np2)) * $RCS_Thrust_N / $RCS_Specific_Impulse_MS * $Delta_Time]"
        },
        {
          "line": 302,
          "text": "   set LM_Weight_Ascent_KG [expr $LM_Weight_Ascent_KG - $RCS_Fuel_Flow]"
        },
        {
          "line": 303,
          "text": "   set RCS_Propellant_Mass_KG [expr $RCS_Propellant_Mass_KG - $RCS_Fuel_Flow]"
        }
      ]
    }
  ]
